{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicy",
  "metadata": {
    "name": "rmq-v23-deny-native",
    "labels": {
      "rmq-vertical-scaler-test": "v23-matrix"
    }
  },
  "spec": {
    "failurePolicy": "Fail",
    "matchConstraints": {
      "namespaceSelector": {
        "matchLabels": {
          "rmq-v23-matrix": "rmq-v23-e2e-native"
        }
      },
      "resourceRules": [
        {
          "apiGroups": [
            ""
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "UPDATE"
          ],
          "resources": [
            "pods/resize"
          ]
        }
      ]
    },
    "validations": [
      {
        "expression": "object.metadata.name != \"rmq-probe-server-1\"",
        "message": "v23 deliberate one-broker resize denial"
      }
    ]
  }
}
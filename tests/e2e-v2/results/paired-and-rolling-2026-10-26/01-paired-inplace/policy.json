{
  "configVersion": 2,
  "profileOrder": [
    "LOW",
    "HIGH"
  ],
  "profiles": {
    "LOW": {
      "requests": {
        "cpu": "100m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "1",
        "memory": "1Gi"
      }
    },
    "HIGH": {
      "requests": {
        "cpu": "800m",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "1500m",
        "memory": "1Gi"
      }
    }
  },
  "triggers": [
    {
      "type": "rabbitmq",
      "metadata": {
        "mode": "QueueLength",
        "aggregation": "sum",
        "thresholds": {
          "HIGH": 10
        }
      }
    }
  ],
  "pollingInterval": 15,
  "updatePolicy": {
    "mode": "Auto",
    "allowRollingFallback": false
  },
  "behavior": {
    "scaleUp": {
      "stabilizationSeconds": 30
    },
    "scaleDown": {
      "stepIntervalSeconds": 60,
      "memoryHeadroomPercent": 20
    },
    "metrics": {
      "maxAgeSeconds": 60
    }
  },
  "kubernetes": {
    "namespace": "rmq-v23-e2e-native",
    "rmqServiceName": "rmq-probe"
  },
  "rmq": {
    "host": "rmq-probe.rmq-v23-e2e-native.svc.cluster.local",
    "port": "15672"
  }
}

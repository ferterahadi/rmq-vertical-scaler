{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "name": "rvs-closure-strategy",
        "labels": {
          "rmq-vertical-scaler-test": "v23-closure"
        }
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "namespaceSelector": {
            "matchLabels": {
              "rmq-v23-closure": "rmq-v23-e2e-native"
            }
          },
          "resourceRules": [
            {
              "apiGroups": [
                "rabbitmq.com"
              ],
              "apiVersions": [
                "v1beta1"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "rabbitmqclusters"
              ]
            }
          ]
        },
        "validations": [
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rmq-v23-e2e-native:rmq-vertical-scaler-sa' || !(has(object.spec.override) && has(object.spec.override.statefulSet) && has(object.spec.override.statefulSet.spec) && has(object.spec.override.statefulSet.spec.updateStrategy) && object.spec.override.statefulSet.spec.updateStrategy.type == \"OnDelete\")",
            "message": "v23 closure deliberate strategy denial"
          }
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {
        "name": "rvs-closure-strategy",
        "labels": {
          "rmq-vertical-scaler-test": "v23-closure"
        }
      },
      "spec": {
        "policyName": "rvs-closure-strategy",
        "validationActions": [
          "Deny"
        ],
        "matchResources": {
          "namespaceSelector": {
            "matchLabels": {
              "rmq-v23-closure": "rmq-v23-e2e-native"
            }
          }
        }
      }
    }
  ]
}

{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "v23-dns-observer",
    "namespace": "rmq-v23-e2e-native"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "dns",
        "image": "rabbitmq:4.4.0-management",
        "command": [
          "/bin/bash",
          "-c",
          "for i in $(seq 1 300); do date -u +%Y-%m-%dT%H:%M:%SZ; for n in 0 1 2; do getent ahostsv4 rmq-probe-server-$n.rmq-probe-nodes.rmq-v23-e2e-native.svc.cluster.local || true; done; sleep 2; done"
        ],
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        }
      }
    ]
  }
}

{
  "configVersion": 3,
  "profileOrder": [
    "LOW",
    "MEDIUM",
    "HIGH",
    "CRITICAL"
  ],
  "profiles": {
    "LOW": {
      "requests": {
        "cpu": "500m",
        "memory": "1Gi"
      },
      "limits": {
        "cpu": "5",
        "memory": "8Gi"
      }
    },
    "MEDIUM": {
      "requests": {
        "cpu": "1000m",
        "memory": "2Gi"
      },
      "limits": {
        "cpu": "5",
        "memory": "8Gi"
      }
    },
    "HIGH": {
      "requests": {
        "cpu": "2000m",
        "memory": "4Gi"
      },
      "limits": {
        "cpu": "5",
        "memory": "8Gi"
      }
    },
    "CRITICAL": {
      "requests": {
        "cpu": "4000m",
        "memory": "8Gi"
      },
      "limits": {
        "cpu": "5",
        "memory": "8Gi"
      }
    }
  },
  "triggers": [
    {
      "type": "rabbitmq",
      "metadata": {
        "mode": "QueueLength",
        "aggregation": "max",
        "thresholds": {
          "MEDIUM": 2000,
          "HIGH": 10000,
          "CRITICAL": 50000
        }
      }
    },
    {
      "type": "rabbitmq",
      "metadata": {
        "mode": "MessageRate",
        "thresholds": {
          "MEDIUM": 200,
          "HIGH": 1000,
          "CRITICAL": 5000
        }
      }
    },
    {
      "type": "cpu",
      "metricType": "Utilization",
      "aggregation": "max",
      "metadata": {
        "value": "60"
      }
    },
    {
      "type": "memory",
      "metricType": "Utilization",
      "aggregation": "max",
      "metadata": {
        "value": "75"
      }
    }
  ],
  "pollingInterval": 15,
  "updatePolicy": {
    "mode": "Off",
    "allowRollingFallback": false
  },
  "behavior": {
    "scaleUp": {
      "stabilizationSeconds": 30
    },
    "scaleDown": {
      "stepIntervalSeconds": 300,
      "memoryHeadroomPercent": 20
    },
    "metrics": {
      "maxAgeSeconds": 60
    }
  },
  "kubernetes": {
    "namespace": "production",
    "rmqServiceName": "rabbitmq"
  },
  "rmq": {
    "host": "rabbitmq.production.svc.cluster.local",
    "port": "15672"
  }
}
